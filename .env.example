# ============================================================
# .env.example — COMMIT THIS. Safe template with placeholder values.
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- Infrastructure endpoints ---
# Ollama runs bare on host (NOT dockerized) — standard port
OLLAMA_HOST=http://localhost:11434
# Qdrant runs as standalone container on host — REST API port
QDRANT_URL=http://localhost:6333
# Phoenix container, exposed on host port 6006
PHOENIX_URL=http://localhost:6006
# Phoenix OTLP gRPC collector endpoint for OpenTelemetry traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# --- PostgreSQL (Data Tier, Phase 3.5) ---
# Connection string SQLAlchemy uses. Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://medassist:medassist_dev@localhost:5432/medassist
# These must MATCH the POSTGRES_* vars in docker-compose.yml
POSTGRES_USER=medassist
POSTGRES_PASSWORD=medassist_dev
POSTGRES_DB=medassist

# --- Security ---
# MUST be changed in production. In dev this signs JWTs.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Models (all already downloaded in ~/.ollama) ---
PRIMARY_MODEL=qwen3.5:4b
FALLBACK_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# --- Vector DB ---
QDRANT_COLLECTION=webpos_documents

# --- App ---
# FastAPI listeners (backend runs locally, uvicorn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
